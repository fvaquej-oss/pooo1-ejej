# EJERCICIO 5 - DETECTOR DE NÚMEROS PARES E IMPARES
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Números en lote (*numeros).
# PROCESO:
#   Verificar si un número es par con %. Clasificar en diccionario {'pares': [...], 'impares': [...]}.
# SALIDA:
#   Diccionario con listas clasificadas y tupla con cantidades (cant_pares, cant_impares).
# EJEMPLO DE ENTRADA:
#   an = AnalizadorNumeros()
#   an.separar(1, 2, 3, 4, 5)
# SALIDA ESPERADA:
#   {'pares': [2, 4], 'impares': [1, 3, 5]}

# 2. BOSQUEJO
#   - es_par(n): return n % 2 == 0
#   - separar(*numeros): itera y clasifica según es_par
#   - cantidad_pares_impares(): retorna (len(pares), len(impares))

# 3. PATRÓN
#   Clasificación en estructuras anidadas (diccionario de listas) usando evaluadores booleanos.

# 4. CÓDIGO
class AnalizadorNumeros:
    def __init__(self):
        self.ultimo_analisis = {'pares': [], 'impares': []}

    def es_par(self, numero):
        return numero % 2 == 0

    def separar(self, *numeros):
        pares = []
        impares = []
        for n in numeros:
            if self.es_par(n):
                pares.append(n)
            else:
                impares.append(n)
        self.ultimo_analisis = {'pares': pares, 'impares': impares}
        return self.ultimo_analisis

    def cantidad_pares_impares(self):
        return (len(self.ultimo_analisis['pares']), len(self.ultimo_analisis['impares']))

# 5. PRUEBA
# an = AnalizadorNumeros()
# an.separar(1, 2, 3, 4, 5) -> 1: imp, 2: par, 3: imp, 4: par, 5: imp -> {'pares':[2,4], 'impares':[1,3,5]}


