#   - crear_equipo(nombre): self.equipos[nombre] = []
#   - agregar_jugador(equipo, jugador): append a la lista del equipo existente
#   - equipo_mayor_integrantes(): max() usando key=lambda e: len(self.equipos[e])

# 3. PATRÓN
#   Estructura de datos anidada (Diccionario de Listas) y búsqueda de máximo por propiedad.

# 4. CÓDIGO
class Equipos:
    def __init__(self):
        self.equipos = {}

    def crear_equipo(self, nombre_equipo):
        if nombre_equipo not in self.equipos:
            self.equipos[nombre_equipo] = []

    def agregar_jugador(self, equipo, jugador):
        if equipo in self.equipos:
            self.equipos[equipo].append(jugador)

    def equipo_mayor_integrantes(self):
        if not self.equipos:
            return None
        return max(self.equipos, key=lambda e: len(self.equipos[e]))

