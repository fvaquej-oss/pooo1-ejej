# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Elementos individuales o en lote.
# PROCESO:
#   Contar frecuencias de cada elemento usando un diccionario como contador.
# SALIDA:
#   Elemento más frecuente y su conteo específico.
# EJEMPLO DE ENTRADA:
#   cf = ContadorFrecuencia()
#   cf.agregar_elemento("a")
#   cf.agregar_elemento("b")
#   cf.agregar_elemento("a")
#   cf.elemento_mas_frecuente()
# SALIDA ESPERADA:
#   "a"

# 2. BOSQUEJO
#   - self.frecuencias = {}
#   - agregar_elemento(elem): dict[elem] = dict.get(elem, 0) + 1
#   - elemento_mas_frecuente(): max(self.frecuencias, key=self.frecuencias.get)
#   - frecuencia_elemento(elem): return dict.get(elem, 0)

# 3. PATRÓN
#   Diccionario como tabla de frecuencias (Hash Map pattern).

# 4. CÓDIGO
class ContadorFrecuencia:
    def __init__(self):
        self.frecuencias = {}

    def agregar_elemento(self, elemento):
        self.frecuencias[elemento] = self.frecuencias.get(elemento, 0) + 1

    def elemento_mas_frecuente(self):
        if not self.frecuencias:
            return None
        return max(self.frecuencias, key=self.frecuencias.get)

    def frecuencia_elemento(self, elemento):
        return self.frecuencias.get(elemento, 0)

