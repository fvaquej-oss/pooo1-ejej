# EJERCICIO 16 - CODIFICADOR / DECODIFICADOR CÉSAR
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Letra o palabra y valor de desplazamiento (1-25).
# PROCESO:
#   Desplazar caracteres usando códigos ASCII ord() y chr(). Guardar en diccionario el historial.
# SALIDA:
#   Palabra o letra codificada.
# EJEMPLO DE ENTRADA:
#   cc = CodificadorCesar()
#   cc.codificar_palabra("hola", 3)
# SALIDA ESPERADA:
#   "kroc"

# 2. BOSQUEJO
#   - self.historial = {}
#   - codificar_letra(letra, d): si es minúscula 'a'+(ord(c)-'a'+d)%26. Ídem mayúsculas.
#   - codificar_palabra(palabra, d): une el resultado de codificar_letra y guarda en historial.

# 3. PATRÓN
#   Aritmética modular en ASCII e historial centralizado en diccionario.

# 4. CÓDIGO
class CodificadorCesar:
    def __init__(self):
        self.historial = {}

    def codificar_letra(self, letra, desplazamiento):
        if not letra.isalpha():
            return letra
        base = ord('a') if letra.islower() else ord('A')
        nueva_pos = (ord(letra) - base + desplazamiento) % 26
        return chr(base + nueva_pos)

    def codificar_palabra(self, palabra, desplazamiento):
        codificada = "".join(self.codificar_letra(c, desplazamiento) for c in palabra)
        self.historial[palabra] = codificada
        return codificada

# 5. PRUEBA
# cc = CodificadorCesar()
# cc.codificar_palabra("hola", 3)
# h -> k, o -> r, l -> o, a -> d => "krod" (Guardado en self.historial)


