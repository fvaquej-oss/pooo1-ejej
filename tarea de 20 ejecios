# 2. BOSQUEJO
#   - self.carrito = {}
#   - agregar_articulo(nombre, precio): self.carrito[nombre] = precio
#   - total_carrito(): sum(self.carrito.values())
#   - articulos_por_rango(min, max): lista por comprensión filtrando por valores

# 3. PATRÓN
#   Mapeo Clave-Valor mediante Diccionarios y filtrado por comprensión de listas.

# 4. CÓDIGO
class CarroCompras:
    def __init__(self):
        self.carrito = {}

    def agregar_articulo(self, nombre, precio):
        self.carrito[nombre] = precio

    def total_carrito(self):
        return sum(self.carrito.values())

    def articulos_por_rango(self, precio_min, precio_max):
        return [nombre for nombre, precio in self.carrito.items() if precio_min <= precio <= precio_max]

