# EJERCICIO 4 - INVERSOR DE SECUENCIAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Una lista o múltiples listas (*listas).
# PROCESO:
#   Invertir una lista mediante bucle manual sin usar reversed() ni slicing [::-1].
# SALIDA:
#   Lista invertida o diccionario {tupla(original): lista_invertida}.
# EJEMPLO DE ENTRADA:
#   inv = InversorSecuencia()
#   inv.invertir_lista([1, 2, 3])
# SALIDA ESPERADA:
#   [3, 2, 1]

# 2. BOSQUEJO
#   - invertir_lista(lista): iterar desde len(lista)-1 hasta 0 agregando a una nueva lista.
#   - invertir_multiples(*listas): retorne diccionario mapeando la tupla de la lista original a la invertida.

# 3. PATRÓN
#   Recorrido manual indexado inverso y uso de tuplas como claves inmutables en diccionarios.

# 4. CÓDIGO
class InversorSecuencia:
    def invertir_lista(self, lista):
        invertida = []
        for i in range(len(lista) - 1, -1, -1):
            invertida.append(lista[i])
        return invertida

    def invertir_multiples(self, *listas):
        resultado = {}
        for l in listas:
            resultado[tuple(l)] = self.invertir_lista(l)
        return resultado

