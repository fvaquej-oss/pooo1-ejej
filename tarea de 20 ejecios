# EJERCICIO 12 - SELECTOR DE RANGO CON TUPLAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Pares (inicio, fin) que definen rangos numéricos.
# PROCESO:
#   Generar una tupla para cada rango. Combinar múltiples rangos eliminando duplicados mediante un conjunto.
# SALIDA:
#   Lista de elementos únicos pertenecientes a los rangos.
# EJEMPLO DE ENTRADA:
#   sr = SelectorRango()
#   sr.elementos_en_multiples_rangos((1, 3), (2, 4))
# SALIDA ESPERADA:
#   [1, 2, 3, 4]

# 2. BOSQUEJO
#   - crear_rango(inicio, fin): tuple(range(inicio, fin + 1))
#   - elementos_en_multiples_rangos(*rangos): conjunto vacio, iterar rangos, iterar elementos, agregar a set, retornar list.

# 3. PATRÓN
#   Generación de tuplas inmutables y unificación de conjuntos para eliminación de duplicados.

# 4. CÓDIGO
class SelectorRango:
    def crear_rango(self, inicio, fin):
        return tuple(range(inicio, fin + 1))

    def elementos_en_multiples_rangos(self, *rangos):
        unicos = set()
        for r in rangos:
            rango_tupla = self.crear_rango(r[0], r[1])
            unicos.update(rango_tupla)
        return sorted(list(unicos))

