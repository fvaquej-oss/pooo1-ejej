# EJERCICIO 17 - GRUPO DE EDADES
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Edades numéricas en lote.
# PROCESO:
#   Clasificar en: "niño" (<12), "adolescente" (12-17), "adulto" (18-64), "mayor" (>=65).
#   Agrupar en diccionario y calcular promedio por categoría.
# SALIDA:
#   Diccionario agrupado y float promedio de la categoría.
# EJEMPLO DE ENTRADA:
#   ae = AgrupadorEdades()
#   ae.agrupar_por_categoria(5, 15, 30, 70)
# SALIDA ESPERADA:
#   {'niño': [5], 'adolescente': [15], 'adulto': [30], 'mayor': [70]}

# 2. BOSQUEJO
#   - clasificar_edad(edad): bloque if/elif/else
#   - agrupar_por_categoria(*edades): inicializa dict con listas vacías y distribuye.
#   - edad_promedio_categoria(cat): calcula sum/len sobre la categoría.

# 3. PATRÓN
#   Agrupación por categorias en diccionarios anidados con listas.

# 4. CÓDIGO
class AgrupadorEdades:
    def __init__(self):
        self.grupos = {'niño': [], 'adolescente': [], 'adulto': [], 'mayor': []}

    def clasificar_edad(self, edad):
        if edad < 12:
            return "niño"
        elif edad <= 17:
            return "adolescente"
        elif edad <= 64:
            return "adulto"
        else:
            return "mayor"

    def agrupar_por_categoria(self, *edades):
        self.grupos = {'niño': [], 'adolescente': [], 'adulto': [], 'mayor': []}
        for e in edades:
            cat = self.clasificar_edad(e)
            self.grupos[cat].append(e)
        return self.grupos

    def edad_promedio_categoria(self, categoria):
        edades = self.grupos.get(categoria, [])
        return sum(edades) / len(edades) if edades else 0.0

# 5. PRUEBA
# ae = AgrupadorEdades()
# ae.agrupar_por_categoria(5, 15, 30, 70) -> niño:[5], adolescente:[15], adulto:[30], mayor:[70]


