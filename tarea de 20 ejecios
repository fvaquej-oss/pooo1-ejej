# EJERCICIO 18 - MATRIZ DE DISTANCIAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Tuplas de coordenadas (x, y).
# PROCESO:
#   Calcular distancia euclidiana: sqrt((x2-x1)^2 + (y2-y1)^2).
#   Buscar el punto más cercano a un punto de referencia y guardar historial de distancias.
# SALIDA:
#   Distancia en float y tupla del punto más cercano.
# EJEMPLO DE ENTRADA:
#   cd = CalculadorDistancia()
#   cd.distancia_euclidiana((0,0), (3,4))
# SALIDA ESPERADA:
#   5.0

# 2. BOSQUEJO
#   - self.historial_distancias = []
#   - distancia_euclidiana(p1, p2): math.sqrt((p2[0]-p1[0])**2 + (p2[1]-p1[1])**2)
#   - punto_mas_cercano(ref, *puntos): min(puntos, key=lambda p: distancia(ref, p))

# 3. PATRÓN
#   Representación de datos espaciales mediante Tuplas 2D y búsqueda de mínimo.

# 4. CÓDIGO
class CalculadorDistancia:
    def __init__(self):
        self.historial_distancias = []

    def distancia_euclidiana(self, p1, p2):
        d = math.sqrt((p2[0] - p1[0]) ** 2 + (p2[1] - p1[1]) ** 2)
        self.historial_distancias.append(d)
        return d

    def punto_mas_cercano(self, referencia, *puntos):
        if not puntos:
            return None
        return min(puntos, key=lambda p: self.distancia_euclidiana(referencia, p))

