#   rn.registrar("Ana", 95)
#   rn.registrar("Bob", 70)
#   rn.mejor_estudiante()
# SALIDA ESPERADA:
#   ("Ana", 95)

# 2. BOSQUEJO
#   - self.registro = {}
#   - registrar(est, nota): self.registro[est] = nota
#   - estudiantes_aprobados(minima): [est for est, n in self.registro.items() if n >= minima]
#   - mejor_estudiante(): max sobre items() usando la nota como clave de comparación.

# 3. PATRÓN
#   Uso de .items() para iteración simultánea de Clave-Valor y ordenación por valor.

# 4. CÓDIGO
class RegistroNotas:
    def __init__(self):
        self.registro = {}

    def registrar(self, estudiante, nota):
        self.registro[estudiante] = nota

    def estudiantes_aprobados(self, nota_minima):
        return [est for est, nota in self.registro.items() if nota >= nota_minima]

    def mejor_estudiante(self):
        if not self.registro:
            return None
        mejor = max(self.registro.items(), key=lambda x: x[1])
        return mejor

