# EJERCICIO 19 - INVENTARIO DE PRODUCTOS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Nombre de producto y cantidades a sumar o restar.
# PROCESO:
#   Gestión de stock en diccionario {producto: cantidad}. Restar sólo si el stock es suficiente.
# SALIDA:
#   Booleano indicando éxito de la resta y lista de productos bajo un stock mínimo.
# EJEMPLO DE ENTRADA:
#   inv = Inventario()
#   inv.agregar_stock("pan", 50)
#   inv.restar_stock("pan", 30)
#   inv.productos_bajo_stock(15)
# SALIDA ESPERADA:
#   True
#   ["pan"]

# 2. BOSQUEJO
#   - self.stock = {}
#   - agregar_stock(prod, cant): suma a la cantidad existente
#   - restar_stock(prod, cant): valida que exista y stock >= cant. Descuenta y retorna True, si no False.
#   - productos_bajo_stock(minimo): retorna lista de prods con stock < minimo

# 3. PATRÓN
#   Mantenimiento de estado e integridad de datos en diccionarios.

# 4. CÓDIGO
class Inventario:
    def __init__(self):
        self.stock = {}

    def agregar_stock(self, producto, cantidad):
        self.stock[producto] = self.stock.get(producto, 0) + cantidad

    def restar_stock(self, producto, cantidad):
        if producto in self.stock and self.stock[producto] >= cantidad:
            self.stock[producto] -= cantidad
            return True
        return False

    def productos_bajo_stock(self, minimo):
        return [prod for prod, cant in self.stock.items() if cant < minimo]

