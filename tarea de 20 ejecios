# EJERCICIO 15 - DIVISORES DE UN NÚMERO
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Uno o varios números enteros.
# PROCESO:
#   Encontrar divisores con el operador de residuo %. Determinar si un número es perfecto (suma divisores propios == n).
# SALIDA:
#   Tupla de divisores, booleano de número perfecto y diccionario {numero: tupla_divisores}.
# EJEMPLO DE ENTRADA:
#   df = DivisorFinder()
#   df.encontrar_divisores(12)
# SALIDA ESPERADA:
#   (1, 2, 3, 4, 6, 12)

# 2. BOSQUEJO
#   - encontrar_divisores(n): tuple(i for i in range(1, n+1) if n % i == 0)
#   - es_perfecto(n): divisores_propios = divisores sin n. sum(propios) == n
#   - encontrar_multiples_divisores(*numeros): dict {n: encontrar_divisores(n)}

# 3. PATRÓN
#   Cálculos matemáticos con comprensiones tupled y composición de métodos de clase.

# 4. CÓDIGO
class DivisorFinder:
    def encontrar_divisores(self, numero):
        if numero <= 0:
            return ()
        return tuple(i for i in range(1, numero + 1) if numero % i == 0)

    def es_perfecto(self, numero):
        if numero <= 1:
            return False
        divisores = self.encontrar_divisores(numero)
        divisores_propios = divisores[:-1]  # Excluye el mismo número
        return sum(divisores_propios) == numero

    def encontrar_multiples_divisores(self, *numeros):
        return {n: self.encontrar_divisores(n) for n in numeros}

