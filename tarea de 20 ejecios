# EJERCICIO 9 - VALIDADOR DE CARACTERES
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Cadenas de texto.
# PROCESO:
#   Evaluar si un carácter es vocal. Clasificar caracteres de un texto en vocales, consonantes y dígitos.
#   Mantener registro del texto más largo procesado.
# SALIDA:
#   Diccionario con conteos por tipo.
# EJEMPLO DE ENTRADA:
#   astr = AnalizadorString()
#   astr.contar_por_tipo("Hola123")
# SALIDA ESPERADA:
#   {'vocales': 2, 'consonantes': 2, 'digitos': 3}

# 2. BOSQUEJO
#   - self.texto_mas_largo = ""
#   - solo_vocales(letra): vocal en 'aeiouAEIOU'
#   - contar_por_tipo(texto): iterar char por char. Usar isdigit(), solo_vocales() e isalpha().

# 3. PATRÓN
#   Análisis de cadenas con acumuladores de categorías en diccionarios.

# 4. CÓDIGO
class AnalizadorString:
    def __init__(self):
        self.texto_mas_largo = ""

    def solo_vocales(self, letra):
        return letra.lower() in 'aeiou' and len(letra) == 1

    def contar_por_tipo(self, texto):
        if len(texto) > len(self.texto_mas_largo):
            self.texto_mas_largo = texto

        conteos = {'vocales': 0, 'consonantes': 0, 'digitos': 0}
        for char in texto:
            if char.isdigit():
                conteos['digitos'] += 1
            elif char.isalpha():
                if self.solo_vocales(char):
                    conteos['vocales'] += 1
                else:
                    conteos['consonantes'] += 1
        return conteos

