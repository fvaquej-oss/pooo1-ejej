# EJERCICIO 20 - ANALIZADOR DE PATRONES EN TEXTOS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Cadenas de texto y patrón de búsqueda.
# PROCESO:
#   Dividir texto en palabras, encontrar coincidencias por prefijo, agrupar por longitud y extraer palabras únicas.
# SALIDA:
#   Listas filtradas, diccionario {longitud: [palabras]} y conjunto de palabras únicas.
# EJEMPLO DE ENTRADA:
#   ap = AnalizadorPatrones()
#   ap.agrupar_por_longitud("el gato está aquí")
# SALIDA ESPERADA:
#   {2: ['el'], 4: ['gato'], 5: ['está', 'aquí']}

# 2. BOSQUEJO
#   - encontrar_palabras(texto, patron): usa split() y startswith()
#   - agrupar_por_longitud(texto): mapea len(p) -> lista de palabras
#   - palabras_unicas(texto): retorna set(texto.split())

# 3. PATRÓN
#   Combinación avanzada de colecciones (Lista, Conjunto, Diccionario) y manipulación de Strings.

# 4. CÓDIGO
class AnalizadorPatrones:
    def encontrar_palabras(self, texto, patron):
        palabras = texto.split()
        return [p for p in palabras if p.startswith(patron)]

    def agrupar_por_longitud(self, texto):
        palabras = texto.split()
        agrupadas = {}
        for p in palabras:
            longitud = len(p)
            if longitud not in agrupadas:
                agrupadas[longitud] = []
            agrupadas[longitud].append(p)
        return agrupadas

    def palabras_unicas(self, texto):
        return set(texto.split())

