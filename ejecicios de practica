# EJERCICIO 7 - CALCULADORA DE FACTORIALES CON CACHÉ
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Uno o varios números enteros no negativos.
# PROCESO:
#   Calcular el factorial de forma iterativa y guardarlo en un diccionario para reutilizarlo.
# SALIDA:
#   Entero factorial y diccionario {numero: factorial}.
# EJEMPLO DE ENTRADA:
#   cf = CalculadoraFactorial()
#   cf.factorial(5)
# SALIDA ESPERADA:
#   120

# 2. BOSQUEJO
#   - self.cache = {}
#   - factorial(n): si está en caché lo retorna; si no, multiplica de 2 hasta n
#   - factoriales_multiples(*numeros): diccionario por comprensión

# 3. PATRÓN
#   Memorización (caché) en diccionario y acumulador multiplicativo.

# 4. CÓDIGO
class CalculadoraFactorial:
    def __init__(self):
        self.cache = {}

    def factorial(self, numero):
        if numero < 0:
            return None
        if numero in self.cache:
            return self.cache[numero]
        resultado = 1
        for i in range(2, numero + 1):
            resultado *= i
        self.cache[numero] = resultado
        return resultado

    def factoriales_multiples(self, *numeros):
        return {n: self.factorial(n) for n in numeros}

# 5. PRUEBA
# cf = CalculadoraFactorial()
# cf.factorial(5) -> 1*2=2, *3=6, *4=24, *5=120 -> 120 (guardado en cache[5])


