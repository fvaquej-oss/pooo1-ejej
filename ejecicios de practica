# EJERCICIO 10 - GENERADOR DE SIGLAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Frases de texto.
# PROCESO:
#   Dividir la frase en palabras y tomar la primera letra de cada una en mayúscula.
# SALIDA:
#   Cadena con la sigla y diccionario de historial {frase: sigla}.
# EJEMPLO DE ENTRADA:
#   gs = GeneradorSiglas()
#   gs.generar_sigla("universidad estatal de milagro")
# SALIDA ESPERADA:
#   "UEDM"

# 2. BOSQUEJO
#   - self.historial = {}
#   - generar_sigla(frase): split(), tomar p[0].upper() y unir con join
#   - generar_multiples(*frases): diccionario por comprensión

# 3. PATRÓN
#   Segmentación de cadenas con split() y construcción por join().

# 4. CÓDIGO
class GeneradorSiglas:
    def __init__(self):
        self.historial = {}

    def generar_sigla(self, frase):
        sigla = "".join(palabra[0].upper() for palabra in frase.split())
        self.historial[frase] = sigla
        return sigla

    def generar_multiples(self, *frases):
        return {f: self.generar_sigla(f) for f in frases}

