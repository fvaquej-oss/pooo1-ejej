# 2. BOSQUEJO
#   - self.ventas = {}
#   - registrar_venta(producto, cantidad): crea lista si no existe y hace append
#   - total_producto(producto): sum de su lista
#   - producto_mas_vendido(): max() con key=suma de la lista

# 3. PATRÓN
#   Diccionario de listas (agrupación) y búsqueda de máximo por valor calculado.

# 4. CÓDIGO
class RegistroVentas:
    def __init__(self):
        self.ventas = {}

    def registrar_venta(self, producto, cantidad):
        if producto not in self.ventas:
            self.ventas[producto] = []
        self.ventas[producto].append(cantidad)

    def total_producto(self, producto):
        return sum(self.ventas.get(producto, []))

    def producto_mas_vendido(self):
        if not self.ventas:
            return None
        return max(self.ventas, key=lambda p: sum(self.ventas[p]))

