# ==============================================================================
# EJERCICIO 1 - VALIDADOR DE CONTRASEÑAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Contraseñas individuales o en lotes (*claves).
# PROCESO:
#   Validar que tenga al menos 8 caracteres, una mayúscula y un dígito.
# SALIDA:
#   Booleano, lista de contraseñas seguras y su cantidad.
# EJEMPLO DE ENTRADA:
#   v = ValidadorContrasenas()
#   v.evaluar_multiples("Python123", "abc", "CLAVE2026")
# SALIDA ESPERADA:
#   ["Python123", "CLAVE2026"]

# 2. BOSQUEJO
#   - self.seguras = []
#   - es_segura(clave): recorre caracteres marcando banderas de mayúscula y dígito
#   - evaluar_multiples(*claves): filtra y guarda las seguras
#   - cantidad_seguras(): len(self.seguras)

# 3. PATRÓN
#   Validación con banderas booleanas (flags) y acumulación filtrada en listas.

# 4. CÓDIGO
class ValidadorContrasenas:
    def __init__(self):
        self.seguras = []

    def es_segura(self, clave):
        if len(clave) < 8:
            return False
        tiene_mayuscula = False
        tiene_digito = False
        for caracter in clave:
            if caracter.isupper():
                tiene_mayuscula = True
            elif caracter.isdigit():
                tiene_digito = True
        return tiene_mayuscula and tiene_digito

    def evaluar_multiples(self, *claves):
        for clave in claves:
            if self.es_segura(clave):
                self.seguras.append(clave)
        return self.seguras

    def cantidad_seguras(self):
        return len(self.seguras)

# 5. PRUEBA
# v = ValidadorContrasenas()
# "Python123" -> 9 caracteres, 'P' mayúscula, '1' dígito -> True
# "abc" -> menos de 8 caracteres -> False
# "CLAVE2026" -> 9 caracteres, mayúsculas, dígitos -> True -> ["Python123", "CLAVE2026"]


