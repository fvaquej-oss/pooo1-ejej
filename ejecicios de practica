# EJERCICIO 2 - CONTROL DE ASISTENCIA
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Nombres de estudiantes que marcan asistencia.
# PROCESO:
#   Guardar cada marca en una lista (historial) y en un conjunto (asistentes únicos).
# SALIDA:
#   Cantidad de estudiantes únicos y porcentaje de asistencia del curso.
# EJEMPLO DE ENTRADA:
#   ca = ControlAsistencia()
#   ca.marcar_multiples("Ana", "Luis", "Ana")
#   ca.total_unicos()
# SALIDA ESPERADA:
#   2

# 2. BOSQUEJO
#   - self.presentes = set() y self.registros = []
#   - marcar(estudiante): agrega a ambas estructuras
#   - marcar_multiples(*estudiantes): llama a marcar por cada uno
#   - porcentaje_asistencia(total_curso): (unicos / total) * 100

# 3. PATRÓN
#   Conjunto para unicidad e historial paralelo en lista, con cálculo porcentual.

# 4. CÓDIGO
class ControlAsistencia:
    def __init__(self):
        self.presentes = set()
        self.registros = []

    def marcar(self, estudiante):
        self.registros.append(estudiante)
        self.presentes.add(estudiante)

    def marcar_multiples(self, *estudiantes):
        for estudiante in estudiantes:
            self.marcar(estudiante)
        return self.presentes

    def total_unicos(self):
        return len(self.presentes)

    def porcentaje_asistencia(self, total_curso):
        if total_curso <= 0:
            return 0.0
        return (len(self.presentes) / total_curso) * 100

# 5. PRUEBA
# ca = ControlAsistencia()
# ca.marcar_multiples("Ana", "Luis", "Ana") -> registros=3, presentes={"Ana","Luis"}
# ca.total_unicos() -> 2 ; ca.porcentaje_asistencia(4) -> 50.0


