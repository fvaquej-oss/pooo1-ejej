# EJERCICIO 15 - CONTADOR DE VOCALES POR PALABRA
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Palabras individuales o en lote (*palabras).
# PROCESO:
#   Contar las vocales de cada palabra y mapearlas en un diccionario.
# SALIDA:
#   Diccionario {palabra: cantidad} y palabra con más vocales.
# EJEMPLO DE ENTRADA:
#   cv = ContadorVocalesPalabra()
#   cv.mapa_vocales("murcielago", "sol")
# SALIDA ESPERADA:
#   {'murcielago': 5, 'sol': 1}

# 2. BOSQUEJO
#   - contar_vocales(palabra): sum(1 for c in palabra.lower() if c in 'aeiou')
#   - mapa_vocales(*palabras): diccionario por comprensión
#   - palabra_con_mas_vocales(*palabras): max() con key=contar_vocales

# 3. PATRÓN
#   Método de clase usado como criterio de comparación (key) en funciones integradas.

# 4. CÓDIGO
class ContadorVocalesPalabra:
    def contar_vocales(self, palabra):
        return sum(1 for c in palabra.lower() if c in 'aeiou')

    def mapa_vocales(self, *palabras):
        return {p: self.contar_vocales(p) for p in palabras}

    def palabra_con_mas_vocales(self, *palabras):
        if not palabras:
            return None
        return max(palabras, key=self.contar_vocales)

