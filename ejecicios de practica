# EJERCICIO 5 - FILTRADOR DE NÚMEROS PRIMOS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Números enteros en lote (*numeros).
# PROCESO:
#   Verificar primalidad probando divisores hasta la raíz cuadrada del número.
# SALIDA:
#   Lista de primos y diccionario {numero: booleano}.
# EJEMPLO DE ENTRADA:
#   fp = FiltradorPrimos()
#   fp.filtrar_primos(2, 4, 7, 9, 11)
# SALIDA ESPERADA:
#   [2, 7, 11]

# 2. BOSQUEJO
#   - es_primo(n): n < 2 -> False; probar i en range(2, sqrt(n)+1)
#   - filtrar_primos(*numeros): lista por comprensión con es_primo
#   - clasificar(*numeros): diccionario por comprensión {n: es_primo(n)}

# 3. PATRÓN
#   Optimización matemática con raíz cuadrada y salida temprana (early return).

# 4. CÓDIGO
class FiltradorPrimos:
    def es_primo(self, numero):
        if numero < 2:
            return False
        for i in range(2, int(math.sqrt(numero)) + 1):
            if numero % i == 0:
                return False
        return True

    def filtrar_primos(self, *numeros):
        return [n for n in numeros if self.es_primo(n)]

    def clasificar(self, *numeros):
        return {n: self.es_primo(n) for n in numeros}

# 5. PRUEBA
# fp = FiltradorPrimos()
# 2 -> primo; 4 -> divisible por 2; 7 -> primo; 9 -> divisible por 3; 11 -> primo
# fp.filtrar_primos(2, 4, 7, 9, 11) -> [2, 7, 11]


