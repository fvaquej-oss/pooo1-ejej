# EJERCICIO 16 - CALCULADORA DE MCD Y MCM
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Dos o más números enteros.
# PROCESO:
#   Aplicar el algoritmo de Euclides para el MCD y la relación MCM = (a * b) / MCD.
# SALIDA:
#   Enteros MCD y MCM.
# EJEMPLO DE ENTRADA:
#   cm = CalculadoraMcdMcm()
#   cm.mcd(12, 18)
#   cm.mcm(12, 18)
# SALIDA ESPERADA:
#   6
#   36

# 2. BOSQUEJO
#   - mcd(a, b): while b != 0: a, b = b, a % b
#   - mcm(a, b): abs(a*b) // mcd(a, b)
#   - mcd_multiple(*numeros): aplicar mcd acumulativamente sobre la secuencia

# 3. PATRÓN
#   Algoritmo iterativo de Euclides y reducción acumulativa sobre varios valores.

# 4. CÓDIGO
class CalculadoraMcdMcm:
    def mcd(self, a, b):
        while b != 0:
            a, b = b, a % b
        return abs(a)

    def mcm(self, a, b):
        if a == 0 or b == 0:
            return 0
        return abs(a * b) // self.mcd(a, b)

    def mcd_multiple(self, *numeros):
        if not numeros:
            return None
        resultado = numeros[0]
        for n in numeros[1:]:
            resultado = self.mcd(resultado, n)
        return resultado

# 5. PRUEBA
# cm = CalculadoraMcdMcm()
# mcd(12, 18) -> (18, 12%18=12) -> (12, 18%12=6) -> (6, 12%6=0) -> 6
# mcm(12, 18) -> (12*18) // 6 = 216 // 6 = 36


