# EJERCICIO 19 - VALIDADOR DE CORREOS ELECTRÓNICOS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Direcciones de correo en lote (*correos).
# PROCESO:
#   Validar que exista un solo '@', usuario no vacío y un punto válido en el dominio.
# SALIDA:
#   Conjunto de correos válidos y diccionario {dominio: cantidad}.
# EJEMPLO DE ENTRADA:
#   vc = ValidadorCorreos()
#   vc.cargar_multiples("ana@unemi.edu.ec", "malcorreo.com", "luis@gmail.com")
# SALIDA ESPERADA:
#   {"ana@unemi.edu.ec", "luis@gmail.com"}

# 2. BOSQUEJO
#   - self.validos = set()
#   - es_valido(correo): count("@") == 1, split("@"), verificar usuario y dominio
#   - cargar_multiples(*correos): agrega los válidos al conjunto
#   - conteo_por_dominio(): acumula con dict.get()

# 3. PATRÓN
#   Validación estructural de cadenas con split() y conteo agrupado en diccionario.

# 4. CÓDIGO
class ValidadorCorreos:
    def __init__(self):
        self.validos = set()

    def es_valido(self, correo):
        if correo.count("@") != 1:
            return False
        usuario, dominio = correo.split("@")
        if len(usuario) == 0 or "." not in dominio:
            return False
        return not dominio.startswith(".") and not dominio.endswith(".")

    def cargar_multiples(self, *correos):
        for correo in correos:
            if self.es_valido(correo):
                self.validos.add(correo)
        return self.validos

    def conteo_por_dominio(self):
        conteo = {}
        for correo in self.validos:
            dominio = correo.split("@")[1]
            conteo[dominio] = conteo.get(dominio, 0) + 1
        return conteo

# 5. PRUEBA
# vc = ValidadorCorreos()
# "ana@unemi.edu.ec" -> un '@', usuario "ana", dominio con punto -> válido
# "malcorreo.com" -> cero '@' -> descartado
# conteo_por_dominio() -> {"unemi.edu.ec": 1, "gmail.com": 1}


