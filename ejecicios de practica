# EJERCICIO 3 - CONVERSOR DE MONEDAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Moneda destino, tasa de cambio y montos a convertir.
# PROCESO:
#   Guardar tasas en un diccionario {moneda: tasa} y multiplicar el monto por la tasa.
# SALIDA:
#   Monto convertido e historial de conversiones como tuplas.
# EJEMPLO DE ENTRADA:
#   cm = ConversorMonedas()
#   cm.registrar_tasa("EUR", 0.92)
#   cm.convertir(100, "EUR")
# SALIDA ESPERADA:
#   92.0

# 2. BOSQUEJO
#   - self.tasas = {} y self.historial = []
#   - registrar_tasa(moneda, tasa): asigna clave-valor
#   - convertir(monto, moneda): valida existencia, multiplica y guarda tupla
#   - convertir_multiples(moneda, *montos): lista con cada conversión

# 3. PATRÓN
#   Tabla de consulta (lookup table) en diccionario con registro histórico en tuplas.

# 4. CÓDIGO
class ConversorMonedas:
    def __init__(self):
        self.tasas = {}
        self.historial = []

    def registrar_tasa(self, moneda, tasa):
        self.tasas[moneda] = tasa

    def convertir(self, monto, moneda):
        if moneda not in self.tasas:
            return None
        resultado = monto * self.tasas[moneda]
        self.historial.append((moneda, monto, resultado))
        return resultado

    def convertir_multiples(self, moneda, *montos):
        return [self.convertir(m, moneda) for m in montos]

# 5. PRUEBA
# cm = ConversorMonedas()
# cm.registrar_tasa("EUR", 0.92) -> tasas = {"EUR": 0.92}
# cm.convertir(100, "EUR") -> 100 * 0.92 = 92.0 (historial: ("EUR", 100, 92.0))


