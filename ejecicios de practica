# EJERCICIO 12 - CONVERSOR DE TEMPERATURAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Temperaturas en grados Celsius o Fahrenheit.
# PROCESO:
#   Aplicar las fórmulas F = C * 9/5 + 32 y C = (F - 32) * 5/9, guardando el historial.
# SALIDA:
#   Valor convertido y tupla con múltiples conversiones.
# EJEMPLO DE ENTRADA:
#   ct = ConversorTemperatura()
#   ct.celsius_a_fahrenheit(25)
# SALIDA ESPERADA:
#   77.0

# 2. BOSQUEJO
#   - self.conversiones = []
#   - celsius_a_fahrenheit(c): aplica fórmula y guarda tupla (c, f)
#   - fahrenheit_a_celsius(f): fórmula inversa
#   - convertir_multiples(*celsius): retorna tupla de resultados

# 3. PATRÓN
#   Aplicación de fórmulas con historial en lista de tuplas y salida inmutable.

# 4. CÓDIGO
class ConversorTemperatura:
    def __init__(self):
        self.conversiones = []

    def celsius_a_fahrenheit(self, celsius):
        fahrenheit = celsius * 9 / 5 + 32
        self.conversiones.append((celsius, fahrenheit))
        return fahrenheit

    def fahrenheit_a_celsius(self, fahrenheit):
        return (fahrenheit - 32) * 5 / 9

    def convertir_multiples(self, *celsius):
        return tuple(self.celsius_a_fahrenheit(c) for c in celsius)

