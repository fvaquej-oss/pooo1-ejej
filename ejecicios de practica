# EJERCICIO 9 - CONTROL DE GASTOS POR CATEGORÍA
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Categoría del gasto y monto.
# PROCESO:
#   Guardar cada gasto como tupla en una lista y acumular totales por categoría en un diccionario.
# SALIDA:
#   Diccionario de totales y categoría con mayor gasto.
# EJEMPLO DE ENTRADA:
#   cg = ControlGastos()
#   cg.registrar_gasto("comida", 20)
#   cg.registrar_gasto("transporte", 5)
#   cg.registrar_gasto("comida", 15)
#   cg.total_por_categoria()
# SALIDA ESPERADA:
#   {'comida': 35, 'transporte': 5}

# 2. BOSQUEJO
#   - self.gastos = []
#   - registrar_gasto(categoria, monto): append((categoria, monto))
#   - total_por_categoria(): acumular con dict.get(cat, 0) + monto
#   - categoria_mayor_gasto(): max() sobre el diccionario de totales

# 3. PATRÓN
#   Lista de tuplas como registro de transacciones y agregación en diccionario.

# 4. CÓDIGO
class ControlGastos:
    def __init__(self):
        self.gastos = []

    def registrar_gasto(self, categoria, monto):
        self.gastos.append((categoria, monto))

    def total_por_categoria(self):
        totales = {}
        for categoria, monto in self.gastos:
            totales[categoria] = totales.get(categoria, 0) + monto
        return totales

    def categoria_mayor_gasto(self):
        totales = self.total_por_categoria()
        if not totales:
            return None
        return max(totales, key=totales.get)

