# EJERCICIO 18 - GESTOR DE RUTAS DE VIAJE
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Ciudad de origen, ciudad de destino y kilómetros.
# PROCESO:
#   Guardar cada ruta como tupla (origen, destino, km) en una lista y recorrer para sumar o comparar.
# SALIDA:
#   Kilometraje total, ruta más larga y conjunto de ciudades visitadas.
# EJEMPLO DE ENTRADA:
#   gr = GestorRutas()
#   gr.agregar_ruta("Milagro", "Guayaquil", 46)
#   gr.agregar_ruta("Guayaquil", "Quito", 420)
#   gr.distancia_total()
# SALIDA ESPERADA:
#   466

# 2. BOSQUEJO
#   - self.rutas = []
#   - agregar_ruta(origen, destino, km): append de la tupla
#   - distancia_total(): sum del tercer elemento
#   - ruta_mas_larga(): max() con key=r[2]
#   - ciudades_visitadas(): conjunto con orígenes y destinos

# 3. PATRÓN
#   Lista de tuplas de tres campos con agregación y unificación en conjunto.

# 4. CÓDIGO
class GestorRutas:
    def __init__(self):
        self.rutas = []

    def agregar_ruta(self, origen, destino, km):
        self.rutas.append((origen, destino, km))

    def distancia_total(self):
        return sum(r[2] for r in self.rutas)

    def ruta_mas_larga(self):
        if not self.rutas:
            return None
        return max(self.rutas, key=lambda r: r[2])

    def ciudades_visitadas(self):
        ciudades = set()
        for origen, destino, km in self.rutas:
            ciudades.add(origen)
            ciudades.add(destino)
        return ciudades

