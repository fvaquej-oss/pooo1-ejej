# EJERCICIO 17 - CLASIFICADOR DE NOTAS EN LETRAS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Notas numéricas en lote (*notas).
# PROCESO:
#   Clasificar: A (>=90), B (>=80), C (>=70), D (>=60), F (<60) y agrupar en diccionario.
# SALIDA:
#   Diccionario agrupado y porcentaje de estudiantes por letra.
# EJEMPLO DE ENTRADA:
#   cn = ClasificadorNotasLetra()
#   cn.agrupar(95, 83, 72, 50)
# SALIDA ESPERADA:
#   {'A': [95], 'B': [83], 'C': [72], 'D': [], 'F': [50]}

# 2. BOSQUEJO
#   - self.grupos con las cinco claves inicializadas en listas vacías
#   - letra(nota): cadena if/elif/else
#   - agrupar(*notas): reinicia grupos y distribuye
#   - porcentaje_letra(letra): len(grupo) / total * 100

# 3. PATRÓN
#   Clasificación por umbrales (rangos) y cálculo de proporciones sobre el total.

# 4. CÓDIGO
class ClasificadorNotasLetra:
    def __init__(self):
        self.grupos = {'A': [], 'B': [], 'C': [], 'D': [], 'F': []}

    def letra(self, nota):
        if nota >= 90:
            return 'A'
        elif nota >= 80:
            return 'B'
        elif nota >= 70:
            return 'C'
        elif nota >= 60:
            return 'D'
        else:
            return 'F'

    def agrupar(self, *notas):
        self.grupos = {'A': [], 'B': [], 'C': [], 'D': [], 'F': []}
        for nota in notas:
            self.grupos[self.letra(nota)].append(nota)
        return self.grupos

    def porcentaje_letra(self, letra):
        total = sum(len(v) for v in self.grupos.values())
        if total == 0:
            return 0.0
        return len(self.grupos.get(letra, [])) / total * 100

# 5. PRUEBA
# cn = ClasificadorNotasLetra()
# 95 -> A ; 83 -> B ; 72 -> C ; 50 -> F
# porcentaje_letra('A') -> 1 / 4 * 100 = 25.0


