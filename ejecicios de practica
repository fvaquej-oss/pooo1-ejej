# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Nombre, especie y edad de la mascota.
# PROCESO:
#   Guardar en diccionario {nombre: (especie, edad)}, filtrar por especie y promediar edades.
# SALIDA:
#   Lista de nombres filtrados y float con la edad promedio.
# EJEMPLO DE ENTRADA:
#   rm = RegistroMascotas()
#   rm.registrar("Rocky", "perro", 4)
#   rm.registrar("Michi", "gato", 2)
#   rm.por_especie("perro")
# SALIDA ESPERADA:
#   ["Rocky"]

# 2. BOSQUEJO
#   - self.mascotas = {}
#   - registrar(nombre, especie, edad): asigna la tupla como valor
#   - por_especie(especie): comprensión sobre items() comparando el primer elemento
#   - edad_promedio(): suma de los segundos elementos / total

# 3. PATRÓN
#   Registros compuestos en tuplas indexadas dentro de un diccionario.

# 4. CÓDIGO
class RegistroMascotas:
    def __init__(self):
        self.mascotas = {}

    def registrar(self, nombre, especie, edad):
        self.mascotas[nombre] = (especie, edad)

    def por_especie(self, especie):
        return [n for n, datos in self.mascotas.items() if datos[0] == especie]

    def edad_promedio(self):
        if not self.mascotas:
            return 0.0
        return sum(datos[1] for datos in self.mascotas.values()) / len(self.mascotas)

# 5. PRUEBA
# rm = RegistroMascotas()
# mascotas -> {"Rocky": ("perro", 4), "Michi": ("gato", 2)}
# por_especie("perro") -> ["Rocky"] ; edad_promedio() -> (4+2)/2 = 3.0


