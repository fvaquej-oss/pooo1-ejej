# EJERCICIO 20 - OPERADOR DE MATRICES
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Matrices representadas como listas de listas.
# PROCESO:
#   Sumar matrices elemento a elemento, transponer filas por columnas y extraer la diagonal.
# SALIDA:
#   Matriz resultante (lista de listas) y tupla con la diagonal principal.
# EJEMPLO DE ENTRADA:
#   om = OperadorMatrices()
#   om.sumar([[1, 2], [3, 4]], [[5, 6], [7, 8]])
# SALIDA ESPERADA:
#   [[6, 8], [10, 12]]

# 2. BOSQUEJO
#   - sumar(m1, m2): validar dimensiones y usar comprensión doble por índices
#   - transpuesta(m): intercambiar índices i y j
#   - diagonal_principal(m): tupla con m[i][i]

# 3. PATRÓN
#   Estructuras anidadas (listas de listas) con recorrido por doble índice.

# 4. CÓDIGO
class OperadorMatrices:
    def sumar(self, m1, m2):
        if len(m1) != len(m2):
            return None
        return [[m1[i][j] + m2[i][j] for j in range(len(m1[i]))] for i in range(len(m1))]

    def transpuesta(self, matriz):
        if not matriz:
            return []
        return [[matriz[i][j] for i in range(len(matriz))] for j in range(len(matriz[0]))]

    def diagonal_principal(self, matriz):
        return tuple(matriz[i][i] for i in range(len(matriz)))

# 5. PRUEBA
# om = OperadorMatrices()
# [[1,2],[3,4]] + [[5,6],[7,8]] -> 1+5=6, 2+6=8, 3+7=10, 4+8=12 -> [[6,8],[10,12]]
# diagonal_principal([[1,2],[3,4]]) -> (1, 4)


