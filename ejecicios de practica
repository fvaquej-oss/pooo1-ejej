# EJERCICIO 8 - ANALIZADOR DE PALÍNDROMOS
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Palabras o frases en lote (*textos).
# PROCESO:
#   Comparar caracteres desde los extremos hacia el centro, sin usar slicing [::-1].
# SALIDA:
#   Booleano, lista de palíndromos y el más largo encontrado.
# EJEMPLO DE ENTRADA:
#   ap = AnalizadorPalindromos()
#   ap.filtrar_palindromos("reconocer", "casa", "anilina")
# SALIDA ESPERADA:
#   ["reconocer", "anilina"]

# 2. BOSQUEJO
#   - self.encontrados = []
#   - es_palindromo(texto): normaliza (minúsculas, sin espacios) y compara i con len-1-i
#   - filtrar_palindromos(*textos): guarda los válidos
#   - palindromo_mas_largo(): max() con key=len

# 3. PATRÓN
#   Recorrido con dos extremos (two pointers) y normalización de cadenas.

# 4. CÓDIGO
class AnalizadorPalindromos:
    def __init__(self):
        self.encontrados = []

    def es_palindromo(self, texto):
        limpio = texto.lower().replace(" ", "")
        for i in range(len(limpio) // 2):
            if limpio[i] != limpio[len(limpio) - 1 - i]:
                return False
        return True

    def filtrar_palindromos(self, *textos):
        for texto in textos:
            if self.es_palindromo(texto):
                self.encontrados.append(texto)
        return self.encontrados

    def palindromo_mas_largo(self):
        if not self.encontrados:
            return None
        return max(self.encontrados, key=len)

# 5. PRUEBA
# ap = AnalizadorPalindromos()
# "reconocer" -> r=r, e=e, c=c, o=o -> True
# "casa" -> c != a -> False
# "anilina" -> True -> ["reconocer", "anilina"]


