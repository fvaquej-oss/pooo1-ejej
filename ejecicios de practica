# EJERCICIO 13 - ESTADÍSTICAS NUMÉRICAS (MEDIANA, MODA Y RANGO)
# ==============================================================================
# 1. ENTENDER EL PROBLEMA
# ENTRADA:
#   Números en lote (*numeros).
# PROCESO:
#   Ordenar los datos para la mediana, contar frecuencias para la moda y restar extremos para el rango.
# SALIDA:
#   Valores estadísticos numéricos.
# EJEMPLO DE ENTRADA:
#   en = EstadisticasNumericas()
#   en.cargar(4, 1, 7, 3)
#   en.mediana()
# SALIDA ESPERADA:
#   3.5

# 2. BOSQUEJO
#   - self.datos = []
#   - cargar(*numeros): extiende la lista
#   - mediana(): ordenar; si n es impar tomar el central, si es par promediar los dos centrales
#   - moda(): diccionario de frecuencias y max()
#   - rango(): max() - min()

# 3. PATRÓN
#   Estadística descriptiva con ordenamiento y tabla de frecuencias.

# 4. CÓDIGO
class EstadisticasNumericas:
    def __init__(self):
        self.datos = []

    def cargar(self, *numeros):
        for n in numeros:
            self.datos.append(n)
        return self.datos

    def mediana(self):
        if not self.datos:
            return None
        ordenados = sorted(self.datos)
        n = len(ordenados)
        medio = n // 2
        if n % 2 == 1:
            return ordenados[medio]
        return (ordenados[medio - 1] + ordenados[medio]) / 2

    def moda(self):
        if not self.datos:
            return None
        frecuencias = {}
        for n in self.datos:
            frecuencias[n] = frecuencias.get(n, 0) + 1
        return max(frecuencias, key=frecuencias.get)

    def rango(self):
        if not self.datos:
            return 0
        return max(self.datos) - min(self.datos)

# 5. PRUEBA
# en = EstadisticasNumericas()
# en.cargar(4, 1, 7, 3) -> ordenados = [1, 3, 4, 7], n = 4 (par)
# mediana -> (3 + 4) / 2 = 3.5 ; rango -> 7 - 1 = 6


